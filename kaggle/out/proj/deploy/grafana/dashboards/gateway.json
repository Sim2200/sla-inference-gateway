{
  "uid": "sla-gateway",
  "title": "SLA inference gateway",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by tier",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier) (rate(gateway_requests_total{outcome=\"ok\"}[15s]))",
          "legendFormat": "{{tier}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gateway_requests_total{outcome=\"shed\"}[15s]))",
          "legendFormat": "shed (503)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(gateway_requests_total{outcome=\"error\"}[15s]))",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "End-to-end p95 latency (SLA = 300 ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_request_seconds_bucket[15s])))",
          "legendFormat": "all requests p95"
        },
        {
          "refId": "B",
          "expr": "gateway_tier_p95_seconds",
          "legendFormat": "{{tier}} p95 (controller view)"
        },
        {
          "refId": "C",
          "expr": "vector(0.3)",
          "legendFormat": "SLA"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Share of traffic sent to the fast tier",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_fast_share",
          "legendFormat": "controller fast share"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gateway_requests_total{tier=\"fast\",outcome=\"ok\"}[15s])) / sum(rate(gateway_requests_total{outcome=\"ok\"}[15s]))",
          "legendFormat": "actual fast share"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Adaptive concurrency limit vs in-flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_concurrency_limit",
          "legendFormat": "limit {{tier}}"
        },
        {
          "refId": "B",
          "expr": "gateway_in_flight",
          "legendFormat": "in flight {{tier}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Routing reasons",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(gateway_requests_total[15s]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Canary weight and circuit breakers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_canary_weight",
          "legendFormat": "canary weight"
        },
        {
          "refId": "B",
          "expr": "gateway_breaker_state",
          "legendFormat": "breaker {{target}} (0 closed, 2 open)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model server queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "modelserver_in_flight",
          "legendFormat": "{{tier}} {{version}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model server inference time p50",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, tier, version) (rate(modelserver_inference_seconds_bucket[30s])))",
          "legendFormat": "{{tier}} {{version}}"
        }
      ]
    }
  ],
  "tags": [
    "sla"
  ]
}